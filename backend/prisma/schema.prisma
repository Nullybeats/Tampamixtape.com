generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String?  // Optional for managed profiles (admin-created)
  name          String?
  artistName    String?
  profileSlug   String?  @unique
  bio           String?
  avatar        String?
  role          Role     @default(USER)
  status        Status   @default(PENDING)
  region        String   @default("Tampa Bay")
  genres        String?  // Comma-separated genres
  genresLocked  Boolean  @default(false) // Prevents auto-sync from overwriting manually set genres
  popularity    Int      @default(0) // Cached popularity score (0-100)
  followers     Int      @default(0) // Cached follower count
  spotifyId     String?             // Legacy — kept for data preservation
  spotifyUrl    String?             // Legacy — kept for data preservation
  appleMusicId  String?             // Apple Music artist ID (numeric string)
  appleMusicUrl String?             // Apple Music artist URL
  syncEnabled   Boolean  @default(true)  // False = quarantined from sync (bad ID, repeated failures)
  syncFailCount Int      @default(0)     // Consecutive sync failures (circuit breaker at 3)
  lastSyncedAt  DateTime?               // When this artist was last successfully synced
  lastSyncError String?                 // Last sync error message for debugging
  appleMusicCache    Json?              // Full enriched Apple Music data (top songs, similar artists, videos, etc.)
  appleMusicCachedAt DateTime?          // When the cache was last refreshed
  demandScore        Int       @default(0)  // TampaMixtape Demand Score (0-100)
  demandScoreTier    String?               // "breakout", "trending", "radar", "building", "emerging"
  demandScoreAt      DateTime?             // When score was last calculated
  instagramUrl  String?
  twitterUrl    String?
  youtubeUrl    String?
  tiktokUrl     String?
  websiteUrl    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("users")
}

enum Role {
  USER
  ARTIST
  ADMIN
}

enum Status {
  PENDING
  APPROVED
  REJECTED
}

model Release {
  id            String   @id // Music platform album ID (Apple Music or legacy Spotify)
  name          String
  type          String   // Album, Single, EP
  image         String?
  releaseDate   String?
  spotifyUrl    String?  // Legacy — kept for existing data
  appleMusicUrl String?  // Apple Music album URL
  artistId      String   // Reference to User.id
  artistName    String
  artistSlug    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([artistId])
  @@index([releaseDate])
  @@map("releases")
}

model Settings {
  id                    String   @id @default("app_settings")
  autoSyncEnabled       Boolean  @default(false)
  autoSyncIntervalMins  Int      @default(60) // Interval in minutes (30, 60, 90, etc.)
  lastSyncAt            DateTime?
  lastSyncStatus        String?  // "success", "partial", "failed"
  lastSyncMessage       String?
  adImageUrl            String?  // URL or base64 data for the advertisement image
  adImageLink           String?  // Link URL when ad is clicked
  updatedAt             DateTime @updatedAt

  @@map("settings")
}

model Follow {
  id         String   @id @default(cuid())
  followerId String   // The user who is following
  artistId   String   // The artist being followed
  createdAt  DateTime @default(now())

  @@unique([followerId, artistId])
  @@index([followerId])
  @@index([artistId])
  @@map("follows")
}

model Like {
  id         String   @id @default(cuid())
  userId     String   // The user who liked
  trackId    String   // Apple Music track ID
  trackName  String   // Denormalized for display
  artistName String   // Denormalized for display
  albumImage String?  // Denormalized for display
  trackUrl   String?  // Apple Music track URL
  createdAt  DateTime @default(now())

  @@unique([userId, trackId])
  @@index([userId])
  @@index([trackId])
  @@index([artistName])
  @@map("likes")
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

model SyncLog {
  id              String   @id @default(cuid())
  type            String   // "full", "single", "chunk"
  status          String   // "success", "partial", "failed"
  message         String
  artistsSynced   Int      @default(0)
  artistsFailed   Int      @default(0)
  artistsSkipped  Int      @default(0)
  errors          String?  // JSON array of {artistName, error}
  duration        Int?     // milliseconds
  createdAt       DateTime @default(now())

  @@map("sync_logs")
}

model ProfileView {
  id        String   @id @default(cuid())
  artistId  String
  viewerIp  String?  // Hashed IP for dedup
  createdAt DateTime @default(now())

  @@index([artistId])
  @@index([artistId, createdAt])
  @@map("profile_views")
}

model ProfileClaim {
  id              String      @id @default(cuid())
  profileId       String      // User.id being claimed
  claimantEmail   String      // Email of person claiming
  instagramUrl    String?
  twitterUrl      String?
  tiktokUrl       String?
  youtubeUrl      String?
  websiteUrl      String?
  proofText       String      // Explanation/proof of identity
  message         String?     // Optional message to admin
  status          ClaimStatus @default(PENDING)
  reviewedBy      String?     // Admin user ID who reviewed
  reviewedAt      DateTime?
  reviewNotes     String?     // Admin notes on decision
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([profileId])
  @@index([claimantEmail])
  @@index([status])
  @@map("profile_claims")
}
